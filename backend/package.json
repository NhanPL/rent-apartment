{
  "name": "rent-apartment-backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "check": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "node scripts/test-integration.js",
    "audit": "npm audit --audit-level=high",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:verify": "node scripts/migrate.js --verify",
    "db:seed": "node scripts/migrate.js --seed",
    "db:seed:e2e": "node scripts/seed-e2e.js",
    "db:schema:export": "node scripts/export-schema.js --output ../database.sql"
  },
  "dependencies": {
    "@sentry/node": "^10.72.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "nodemailer": "^9.0.6",
    "otplib": "^13.5.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
